{
  "name": "nicolas-rosas-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "build": "tsc -b && vite build --configLoader native && node scripts/make-offline.mjs",
    "preview": "vite preview --host 127.0.0.1 --configLoader native",
    "test:feed": "node --experimental-strip-types --test work/footballFeed.test.ts",
    "test": "node --experimental-strip-types --test work/footballFeed.test.ts tests/*.test.ts",
    "format": "prettier --write src tests scripts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
